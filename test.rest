@baseUrl = http://localhost:3000

### ════════════════════════════════════════════
### AUTH
### ════════════════════════════════════════════

### Register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Test User",
  "email": "test@example.com",
  "password": "password123"
}

### Login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123"
}

### ════════════════════════════════════════════
### PROFILE
### ════════════════════════════════════════════

### Get my profile
GET {{baseUrl}}/api/profile

### Get profile by ID
GET {{baseUrl}}/api/profile/{{userId}}

### Complete profile
POST {{baseUrl}}/api/profile/complete
Content-Type: application/json

{
  "bio": "I love learning new skills",
  "location": "New York",
  "skillsToTeach": ["JavaScript", "React"],
  "skillsToLearn": ["Python", "Go"]
}

### ════════════════════════════════════════════
### DASHBOARD
### ════════════════════════════════════════════

### Get dashboard stats
GET {{baseUrl}}/api/dashboard

### ════════════════════════════════════════════
### DISCOVER
### ════════════════════════════════════════════

### Find skill matches
GET {{baseUrl}}/api/discover

### ════════════════════════════════════════════
### BADGES
### ════════════════════════════════════════════

### Get my badges
GET {{baseUrl}}/api/badges

### ════════════════════════════════════════════
### SWAP REQUESTS
### ════════════════════════════════════════════

### Get my swap requests (sent + received)
GET {{baseUrl}}/api/swapRequest

### Create swap request
POST {{baseUrl}}/api/swapRequest
Content-Type: application/json

{
  "receiverId": "{{userId}}",
  "teachSkillName": "JavaScript",
  "learnSkillName": "Python",
  "message": "Hey! I'd love to trade skills with you."
}

### Update swap request status
PATCH {{baseUrl}}/api/swapRequest/{{swapRequestId}}
Content-Type: application/json

{
  "status": "accepted"
}

### ════════════════════════════════════════════
### SESSIONS
### ════════════════════════════════════════════

### Get my sessions
GET {{baseUrl}}/api/sessions

### Create session
POST {{baseUrl}}/api/sessions
Content-Type: application/json

{
  "swapRequestId": "{{swapRequestId}}",
  "title": "JavaScript Basics",
  "description": "Learning variables and functions",
  "date": "2026-08-01",
  "startTime": "10:00",
  "endTime": "11:00",
  "timezone": "America/New_York",
  "meetLink": "https://meet.google.com/abc-defg-hij"
}

### Update session status
PATCH {{baseUrl}}/api/sessions/{{sessionId}}
Content-Type: application/json

{
  "status": "completed"
}

### Get my availability
GET {{baseUrl}}/api/sessions/availability

### Set availability
PUT {{baseUrl}}/api/sessions/availability
Content-Type: application/json

{
  "slots": [
    { "day": "Monday", "startTime": "09:00", "endTime": "12:00" },
    { "day": "Wednesday", "startTime": "14:00", "endTime": "17:00" },
    { "day": "Friday", "startTime": "10:00", "endTime": "15:00" }
  ]
}

### ════════════════════════════════════════════
### CHAT
### ════════════════════════════════════════════

### Get my chat rooms
GET {{baseUrl}}/api/chat/rooms

### Get messages in room
GET {{baseUrl}}/api/chat/{{roomId}}/messages

### Send message
POST {{baseUrl}}/api/chat/{{roomId}}/messages
Content-Type: application/json

{
  "content": "Hey, are you available for a session tomorrow?",
  "fileUrl": null
}

### ════════════════════════════════════════════
### REVIEWS
### ════════════════════════════════════════════

### Get review for a swap request
GET {{baseUrl}}/api/review?swapRequestId={{swapRequestId}}&reviewerId={{userId}}

### Submit review
POST {{baseUrl}}/api/review
Content-Type: application/json

{
  "swapRequestId": "{{swapRequestId}}",
  "reviewedId": "{{userId}}",
  "rating": 5,
  "comment": "Great teacher! Very patient and knowledgeable."
}

### ════════════════════════════════════════════
### REPUTATION
### ════════════════════════════════════════════

### Get my reputation
GET {{baseUrl}}/api/reputation

### Get reputation by user ID
GET {{baseUrl}}/api/reputation?userId={{userId}}

### Update social links
PUT {{baseUrl}}/api/reputation
Content-Type: application/json

{
  "action": "updateLinks",
  "links": {
    "github": "https://github.com/username",
    "linkedin": "https://linkedin.com/in/username"
  }
}

### Verify skill
PUT {{baseUrl}}/api/reputation
Content-Type: application/json

{
  "action": "verifySkill",
  "skillName": "JavaScript"
}
